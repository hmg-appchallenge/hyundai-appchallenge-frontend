<?xml version="1.0" encoding="utf-8"?>
<!--
    디버그 빌드 전용. local.properties의 kidsrhythm.serverUrl을 같은 와이파이의 PC 주소(http://192.168.x.x:8000 등)로
    바꿔 실제 기기에서 시험할 수 있게 평문(http)을 모두 허용한다. 릴리스 빌드는 main의 설정(10.0.2.2, localhost만)을 쓴다.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
