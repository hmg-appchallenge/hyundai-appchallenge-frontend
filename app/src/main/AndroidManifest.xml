<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 노래 생성 서버(docs/API.md)와 통신 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 가족 목소리 녹음 (S02 목소리 등록, S04 녹음) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 주행 속도 → 베이스 비트, 바깥 온도 → 계절 악기 (AAOS Car API) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />

    <!-- S02 시작 음성 안내에 기기 음성 합성(TTS) 엔진을 찾는다 (Android 11+ 패키지 공개 범위) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- screenOrientation은 지정하지 않는다. Pleos Connect 가이드는 가로·세로 레이아웃 모두 대응을 기본으로 한다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- AAOS는 이 값이 없는 Activity를 주행 중 차단한다. 주 사용 맥락이 주행 중이라 선언한다. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
